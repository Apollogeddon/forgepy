{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug CLI (init --dry-run)",
      "type": "debugpy",
      "request": "launch",
      "module": "forgepy",
      "args": ["init", "--dry-run"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug pytest (current file)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
